  <plugin>
    org.contikios.cooja.plugins.ScriptRunner
    <plugin_config>
      <script>TIMEOUT(1800000); /* 8-node KA-ack-fix verification */
log.log("Dumping every mote log line\n");
while(true) {
  YIELD();
  log.log("t=" + time + " id=" + id + ": " + msg + "\n");
}</script>
      <active>true</active>
    </plugin_config>
  </plugin>
